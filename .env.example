# Copy to .env for local dev. In Docker these come from docker-compose; as a Home
# Assistant add-on none of them are needed.
#
# Everything below is *seeding*: on boot, each value is copied into the Settings row
# only while that field still holds its default (see src/lib/bootstrap.ts). Edits made
# in the Settings UI always win and are never overwritten. This is what lets a fresh
# database — a new worktree, a rebuilt container, a wiped volume — come up configured.
DATABASE_URL="file:./dev.db?connection_limit=1"

# --- Home Assistant connection ---
# Not needed as an add-on: the app authenticates through the Supervisor instead.
# For standalone Docker, create the token in HA under profile -> Security ->
# Long-Lived Access Tokens. The URL must be reachable from wherever this app runs —
# a .local hostname often isn't, from inside a container.
HA_BASE_URL=""
HA_ACCESS_TOKEN=""

# --- Entity IDs ---
# The charger switch is the only one required for the app to control anything;
# the rest are optional, read-only signals.
HA_CHARGER_SWITCH_ENTITY_ID=""
HA_CHARGER_STATUS_ENTITY_ID=""
# Must be a binary_sensor that is "on" when a cable is physically connected. Do not
# point this at a device_class:connectivity sensor (charger-online) — that reads "on"
# permanently and would force every current hour to count as "home".
HA_CHARGER_CONNECTED_ENTITY_ID=""
HA_POWER_SENSOR_ENTITY_ID=""
HA_CAR_SOC_ENTITY_ID=""

# --- Charger services, as domain.service ---
# Defaults suit a plain switch entity; override for integrations that expose charging
# control differently (e.g. zaptec.start_charging).
HA_CHARGER_ON_SERVICE="switch.turn_on"
HA_CHARGER_OFF_SERVICE="switch.turn_off"
