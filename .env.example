# Copy to .env for local dev. In Docker these come from docker-compose.
DATABASE_URL="file:./dev.db?connection_limit=1"

# Bearer token Home Assistant must send to /api/ha/* endpoints.
# Also settable in the UI Settings page (DB value wins if set there).
HA_API_TOKEN="change-me"

# Optional single password to gate the UI (leave empty to disable).
UI_PASSWORD=""
