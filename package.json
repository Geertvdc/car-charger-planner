{
  "name": "car-charger-planner",
  "version": "0.2.0",
  "private": true,
  "description": "Self-hosted planner that charges your EV on cheap dynamic-price/solar hours while meeting a morning readiness target, respecting a weekly home/away schedule, and controlling the charger via Home Assistant.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Geertvdc/car-charger-planner.git"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "worker": "tsx src/worker/index.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.3.1",
    "@types/luxon": "^3.7.3",
    "luxon": "^3.7.2",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "prisma": "^6.3.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4"
  }
}
