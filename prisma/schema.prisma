// Car Charger Planner — data model
// SQLite has no native enums; status/source fields are strings with documented values.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---- Configuration (singletons keyed by id = 1) ----

model Settings {
  id                 Int      @id @default(1)
  locationName       String   @default("")
  latitude           Float    @default(52.37)
  longitude          Float    @default(4.90)
  timezone           String   @default("Europe/Amsterdam")
  // All-in price = rawEpex + energyTaxPerKwh + supplierFeePerKwh, then * (1 + vatRate)
  energyTaxPerKwh    Float    @default(0.1088)
  supplierFeePerKwh  Float    @default(0.02)
  vatRate            Float    @default(0.21)
  feedInTariffPerKwh Float    @default(0.0)
  // Fraction of forecast PV assumed available to the car (rest is house load). 0..1
  houseLoadFactor    Float    @default(0.7)
  // Opportunistic charging: when an hour's effective cost/kWh drops at or below this,
  // charge even without a target need (capped at CarConfig.maxSoc). Null disables it.
  cheapPriceThresholdPerKwh Float?
  historyDays        Int      @default(3)
  haToken            String   @default("") // verifies INBOUND requests to /api/ha/* (legacy poll path)
  // --- Outbound Home Assistant REST API client (this app -> HA) ---
  haBaseUrl               String @default("") // e.g. http://homeassistant.local:8123, no trailing slash
  haAccessToken            String @default("") // HA long-lived access token, sent as Bearer by this app
  haChargerSwitchEntityId  String @default("") // e.g. switch.zaptec_go_2 — on/off control target
  haChargerStatusEntityId  String @default("") // optional: sensor for charging power/status (read-only, display)
  // HA service to call for each action, in "domain.service" notation. Defaults match a
  // plain switch entity; override for integrations that expose charging control
  // differently (e.g. a custom "zaptec.start_charging" service).
  haChargerOnService       String @default("switch.turn_on")
  haChargerOffService      String @default("switch.turn_off")
  // HomeWizard power sensor entity read via HA (e.g. sensor.p1_meter_active_power_w).
  // Read + stored for display only — not wired into the planning engine.
  haPowerSensorEntityId    String @default("")
  // Car SoC % sensor read via HA (e.g. the EU Data Act portal integration for Cupra/VW
  // Group cars). Read-only, feeds CarState with source "ha_car" — see refreshCarSoc().
  haCarSocEntityId         String @default("")
  // Charger's "cable connected" binary_sensor (e.g. binary_sensor.zaptec_go_2_charger).
  // When "on", the current hour is treated as home even if the schedule says away —
  // see refreshChargerConnected() / PlanState.chargerConnected.
  haChargerConnectedEntityId String @default("")
  // When set, the planner/timeline/HA treat this instant as "now" (simulation mode).
  simulatedNow       DateTime?
  updatedAt          DateTime @updatedAt @default(now())
}

model CarConfig {
  id            Int      @id @default(1)
  batteryKwh    Float    @default(58)
  chargerPowerKw Float   @default(11)
  efficiency    Float    @default(0.9) // 0..1
  minSoc        Int      @default(10)
  maxSoc        Int      @default(90)
  updatedAt     DateTime @updatedAt @default(now())
}

model PvString {
  id       Int    @id @default(autoincrement())
  name     String @default("PV")
  kwp      Float  @default(3.0)
  tilt     Int    @default(35) // declination degrees, 0=horizontal, 90=vertical
  azimuth  Int    @default(0)  // -180..180, 0=south, -90=east, 90=west (Forecast.Solar convention)
}

// ---- Availability template + overrides ----

model WeeklyDay {
  id           Int          @id @default(autoincrement())
  dayOfWeek    Int          @unique // 0=Monday .. 6=Sunday
  deadlineTime String       @default("07:00")
  targetSoc    Int          @default(80)
  windows      HomeWindow[]
}

model DayOverride {
  id           Int          @id @default(autoincrement())
  date         String       @unique // YYYY-MM-DD (local)
  deadlineTime String?
  targetSoc    Int?
  away         Boolean      @default(false) // explicitly away all day (no charging)
  note         String?
  windows      HomeWindow[]
}

model HomeWindow {
  id            Int          @id @default(autoincrement())
  startTime     String // HH:MM local
  endTime       String // HH:MM local
  weeklyDay     WeeklyDay?   @relation(fields: [weeklyDayId], references: [id], onDelete: Cascade)
  weeklyDayId   Int?
  dayOverride   DayOverride? @relation(fields: [dayOverrideId], references: [id], onDelete: Cascade)
  dayOverrideId Int?
}

// ---- Runtime / time-series state ----

model CarState {
  id           Int       @id @default(autoincrement())
  soc          Int
  at           DateTime  @default(now())
  source       String    @default("manual") // manual | estimate | ha_car
  // HA entity's own last_changed for ha_car rows — lets refreshCarSoc() dedup repeated
  // stale polls instead of a genuinely new reading. Null for manual/estimate rows.
  rawUpdatedAt DateTime?
}

// Instantaneous home power reading (e.g. HomeWizard P1 via HA) — display only.
model PowerReading {
  id     Int      @id @default(autoincrement())
  watts  Float
  at     DateTime @default(now())
  source String   @default("homewizard_ha")
}

model PriceSnapshot {
  id         Int      @id @default(autoincrement())
  hourStart  DateTime @unique
  rawPrice   Float // raw EPEX EUR/kWh
  allInPrice Float // EUR/kWh incl. taxes/fees/VAT
  fetchedAt  DateTime @default(now())
}

model SolarForecast {
  id         Int      @id @default(autoincrement())
  hourStart  DateTime @unique
  expectedWh Float
  fetchedAt  DateTime @default(now())
}

model ChargeSlot {
  id          Int      @id @default(autoincrement())
  hourStart   DateTime @unique
  on          Boolean  @default(false)
  expectedKwh Float    @default(0)
  expectedCost Float   @default(0)
  source      String   @default("grid") // grid | solar | mixed
  reason      String   @default("target") // target | cheap — why this hour was scheduled
}

model PlanState {
  id            Int      @id @default(1)
  computedAt    DateTime @default(now())
  charging      Boolean  @default(false)
  chargingUntil DateTime?
  targetSoc     Int?
  reason        String   @default("")
  feasible      Boolean  @default(true)
  shortfallKwh  Float    @default(0)
  // Last on/off state successfully pushed to Home Assistant; null = never pushed.
  haSyncOn      Boolean?
  haSyncAt      DateTime?
  haSyncError   String?
  // Latest known charger-connected state (see refreshChargerConnected()) — used to
  // force the current hour "home" even when the schedule says away.
  chargerConnected Boolean @default(false)
}

model ChargeLog {
  id   Int      @id @default(autoincrement())
  at   DateTime @default(now())
  on   Boolean
  note String?
}
